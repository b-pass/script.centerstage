<?xml version="1.0" encoding="UTF-8"?>
<!-- Center Stage main window for Myth Estuary (skin.myth-estuary, the user's Estuary fork).
     Everything from the window element down is identical to the file in
     resources/skins/skin.estuary/xml (tests/test_skins.py checks this), so the window looks the
     same in both skins. Myth Estuary has every include, font, colour and texture it uses. Edit
     the Estuary file and copy it here. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<!-- the user's Estuary colour theme background, then the focused title's fanart like
		     Estuary's own media windows -->
		<control type="group">
			<include>FullScreenDimensions</include>
			<include>ColoredBackgroundImages</include>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<fadetime>400</fadetime>
				<animation effect="fade" time="400">VisibleChange</animation>
				<texture background="true" colordiffuse="37FFFFFF">$INFO[Container(100).ListItem.Art(fanart)]</texture>
				<visible>!Skin.HasSetting(no_fanart)</visible>
			</control>
		</control>

		<!-- left: titles. A plain list, so the first title sits at the top. -->
		<control type="group">
			<include>OpenClose_Left</include>
			<include content="ContentPanel">
				<param name="left" value="-40" />
				<param name="width" value="640" />
			</include>
			<control type="list" id="100">
				<left>0</left>
				<top>130</top>
				<width>550</width>
				<height>880</height>
				<onright>200</onright>
				<onup>100</onup>
				<ondown>100</ondown>
				<pagecontrol>101</pagecontrol>
				<scrolltime tween="cubic" easing="out">300</scrolltime>
				<orientation>vertical</orientation>
				<focusedlayout height="80">
					<!-- stays, dimmed, while the episodes have focus, to mark whose they are -->
					<control type="image">
						<left>0</left>
						<right>0</right>
						<top>0</top>
						<bottom>0</bottom>
						<texture colordiffuse="button_focus">lists/focus.png</texture>
						<animation effect="fade" start="100" end="50" time="40" condition="!Control.HasFocus(100)">Conditional</animation>
					</control>
					<control type="label">
						<left>30</left>
						<right>20</right>
						<top>0</top>
						<bottom>0</bottom>
						<aligny>center</aligny>
						<scroll>true</scroll>
						<font>font27</font>
						<label>$INFO[ListItem.Label]</label>
						<shadowcolor>text_shadow</shadowcolor>
					</control>
				</focusedlayout>
				<itemlayout height="80">
					<control type="label">
						<left>30</left>
						<right>20</right>
						<top>0</top>
						<bottom>0</bottom>
						<aligny>center</aligny>
						<font>font27</font>
						<label>$INFO[ListItem.Label]</label>
						<shadowcolor>text_shadow</shadowcolor>
					</control>
				</itemlayout>
			</control>
			<control type="scrollbar" id="101">
				<left>568</left>
				<top>130</top>
				<width>12</width>
				<height>880</height>
				<onleft>100</onleft>
				<onright>200</onright>
				<orientation>vertical</orientation>
				<animation effect="zoom" end="50,100" time="300" tween="sine" center="568,0" easing="inout" condition="!Control.HasFocus(101)">conditional</animation>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>160</top>
				<width>500</width>
				<height>500</height>
				<font>font27</font>
				<textcolor>grey</textcolor>
				<label>$ADDON[script.centerstage 32029]</label>
				<visible>String.IsEqual(Window.Property(empty),true)</visible>
			</control>
		</control>

		<!-- right: episodes (or folders) on top, details below. The panels run off the right edge
		     of the screen, as the titles panel runs off the left. Everything here is placed from
		     the right edge (<right>), never with a width that assumes 1920: Kodi picks the
		     Estuary coordinate space closest to the window's aspect (e.g. 2040 or 2160 wide). -->
		<control type="group">
			<include>OpenClose_Right</include>
			<left>610</left>
			<right>0</right>
			<control type="group">
				<top>130</top>
				<right>0</right>
				<control type="image">
					<left>-20</left>
					<top>-20</top>
					<right>-40</right>
					<height>520</height>
					<texture colordiffuse="EDFFFFFF">lists/panel.png</texture>
					<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
				</control>
				<control type="list" id="200">
					<left>0</left>
					<top>0</top>
					<right>24</right>
					<height>480</height>
					<onleft>100</onleft>
					<onup>200</onup>
					<ondown>200</ondown>
					<pagecontrol>201</pagecontrol>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<orientation>vertical</orientation>
					<focusedlayout height="60">
						<control type="image">
							<left>0</left>
							<right>0</right>
							<top>0</top>
							<bottom>0</bottom>
							<texture colordiffuse="button_focus">lists/focus.png</texture>
							<visible>Control.HasFocus(200)</visible>
						</control>
						<control type="image">
							<left>16</left>
							<centertop>50%</centertop>
							<width>32</width>
							<height>32</height>
							<texture>$VAR[ListWatchedIconVar]</texture>
							<visible>!String.IsEqual(ListItem.Property(parent),true)</visible>
						</control>
						<control type="label">
							<left>64</left>
							<right>300</right>
							<top>0</top>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<scroll>true</scroll>
							<font>font27</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
						<control type="label">
							<width>280</width>
							<right>20</right>
							<top>0</top>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<font>font12</font>
							<label>$INFO[ListItem.Label2]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
					</focusedlayout>
					<itemlayout height="60">
						<control type="image">
							<left>16</left>
							<centertop>50%</centertop>
							<width>32</width>
							<height>32</height>
							<texture colordiffuse="button_focus">$VAR[ListWatchedIconVar]</texture>
							<visible>!String.IsEqual(ListItem.Property(parent),true)</visible>
						</control>
						<control type="label">
							<left>64</left>
							<right>300</right>
							<top>0</top>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<font>font27</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
						<control type="label">
							<width>280</width>
							<right>20</right>
							<top>0</top>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>grey</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
					</itemlayout>
				</control>
				<!-- flush with the right edge of its panel (the screen's edge) -->
				<control type="scrollbar" id="201">
					<right>0</right>
					<top>0</top>
					<width>12</width>
					<height>480</height>
					<onleft>200</onleft>
					<onright>200</onright>
					<orientation>vertical</orientation>
					<animation effect="zoom" end="50,100" time="300" tween="sine" center="auto" easing="inout" condition="!Control.HasFocus(201)">conditional</animation>
				</control>
				<control type="label">
					<left>64</left>
					<top>90</top>
					<right>64</right>
					<height>60</height>
					<font>font27</font>
					<textcolor>grey</textcolor>
					<label>$ADDON[script.centerstage 32028]</label>
					<visible>String.IsEqual(Window.Property(loading),true)</visible>
				</control>
				<control type="textbox">
					<left>64</left>
					<top>90</top>
					<right>64</right>
					<height>300</height>
					<font>font27</font>
					<textcolor>grey</textcolor>
					<label>$INFO[Window.Property(message)]</label>
					<visible>!String.IsEmpty(Window.Property(message))</visible>
				</control>
			</control>

			<control type="group">
				<top>640</top>
				<right>0</right>
				<control type="image">
					<left>-20</left>
					<top>-20</top>
					<right>-40</right>
					<height>430</height>
					<texture colordiffuse="EDFFFFFF">lists/panel.png</texture>
					<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
				</control>
				<!-- Laid out like the recordings window (MyPVRRecordings.xml): the title's name, and
				     under it the episode's (with S01E02); opposite them, right-aligned in grey, the
				     episode's channel/date/length or where the title comes from; below, the picture
				     on the left (16:9 fills it, 4:3 fills its height) and the plot beside it.
				     Everything stays in place whichever list has focus, so nothing jumps while
				     navigating; only the contents change. -->
				<control type="label">
					<left>10</left>
					<top>10</top>
					<right>450</right>
					<height>45</height>
					<font>font32_title</font>
					<scroll>true</scroll>
					<textcolor>button_focus</textcolor>
					<label>$INFO[Container(100).ListItem.Label]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
				<control type="label">
					<left>10</left>
					<top>55</top>
					<right>450</right>
					<height>45</height>
					<font>font30_title</font>
					<scroll>true</scroll>
					<label>$INFO[Container(200).ListItem.Property(name)]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<right>30</right>
					<top>14</top>
					<width>400</width>
					<height>96</height>
					<font>font25_narrow</font>
					<align>right</align>
					<textcolor>grey</textcolor>
					<label>$INFO[Container(200).ListItem.Property(details)]</label>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<right>30</right>
					<top>14</top>
					<width>400</width>
					<height>96</height>
					<font>font25_narrow</font>
					<align>right</align>
					<textcolor>grey</textcolor>
					<label>$INFO[Container(100).ListItem.Property(origin)]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>110</top>
					<width>480</width>
					<height>270</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true" fallback="DefaultTVShows.png">$INFO[Container(100).ListItem.Art(thumb)]</texture>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>110</top>
					<width>480</width>
					<height>270</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true">$INFO[Container(200).ListItem.Art(thumb)]</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<left>510</left>
					<top>110</top>
					<right>30</right>
					<height>270</height>
					<font>font12</font>
					<label>$INFO[Container(100).ListItem.Plot]</label>
					<autoscroll delay="10000" time="3000" repeat="10000">Skin.HasSetting(autoscroll)</autoscroll>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<left>510</left>
					<top>110</top>
					<right>30</right>
					<height>270</height>
					<font>font12</font>
					<label>$INFO[Container(200).ListItem.Plot]</label>
					<autoscroll delay="10000" time="3000" repeat="10000">Skin.HasSetting(autoscroll)</autoscroll>
					<visible>Control.HasFocus(200)</visible>
				</control>
			</control>
		</control>

		<include content="TopBar">
			<param name="breadcrumbs_label" value="$ADDON[script.centerstage 32001]$INFO[Window.Property(group), / ]$INFO[Window.Property(level), / ]" />
			<param name="sublabel" value="" />
		</include>
		<!-- DVR backend disk space, centred in the top bar. Hidden while something plays, when
		     the top bar shows what's playing there, and when the backend doesn't report it
		     (PVR.BackendDiskSpaceProgr is then 255). -->
		<control type="group">
			<depth>DepthBars</depth>
			<centerleft>50%</centerleft>
			<top>12</top>
			<width>500</width>
			<include>OpenClose_Right</include>
			<visible>String.IsEqual(Window.Property(dvr),true) + !Integer.IsGreater(PVR.BackendDiskSpaceProgr,100) + !Player.HasMedia</visible>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>500</width>
				<height>30</height>
				<align>center</align>
				<font>font25_narrow</font>
				<label>$INFO[PVR.BackendDiskSpace]</label>
				<shadowcolor>text_shadow</shadowcolor>
			</control>
			<control type="progress">
				<left>100</left>
				<top>40</top>
				<width>300</width>
				<height>10</height>
				<info>PVR.BackendDiskSpaceProgr</info>
			</control>
		</control>
	</controls>
</window>
