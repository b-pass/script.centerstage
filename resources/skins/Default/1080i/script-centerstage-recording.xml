<?xml version="1.0" encoding="UTF-8"?>
<!-- Invisible dialog for Kodi's context menu on a recording (window.RecordingMenu). Kodi
     fills the list from the folder in Window(Home).Property(script.centerstage.recordings); a
     list filled from <content> gets Kodi's own context menu, which window.py opens on the
     recording (and for Clear, picks Delete). Nothing is drawn, so one file serves every skin. -->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<controls>
		<control type="list" id="9100">
			<left>0</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
			<content>$INFO[Window(Home).Property(script.centerstage.recordings)]</content>
			<itemlayout height="1" width="1" />
			<focusedlayout height="1" width="1" />
		</control>
	</controls>
</window>
