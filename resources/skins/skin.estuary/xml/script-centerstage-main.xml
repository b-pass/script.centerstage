<?xml version="1.0" encoding="UTF-8"?>
<!-- Center Stage main window, Estuary version. Kodi picks this file over resources/skins/Default
     when the current skin is skin.estuary (WindowXML looks in resources/skins/<skin id>/ first).
     It uses Estuary's own includes, fonts, colours and textures, all present in Kodi 21 and 22:
     ColoredBackgroundImages, TopBar, OpenClose_*, ListWatchedIconVar, button_focus,
     grey, text_shadow, lists/focus.png, and Estuary's scrollbar and progress defaults.
     Control ids and window properties match the Default version. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<!-- the user's Estuary colour theme background, or the picture the skin keeps in
		     Skin.String(centerstage.background) (see the README), then the focused
		     title's fanart like Estuary's own media windows -->
		<control type="group">
			<include>FullScreenDimensions</include>
			<include>ColoredBackgroundImages</include>
			<control type="group">
				<visible>!String.IsEmpty(Skin.String(centerstage.background))</visible>
				<control type="image">
					<include>FullScreenDimensions</include>
					<texture>colors/black.png</texture>
				</control>
				<control type="image">
					<include>FullScreenDimensions</include>
					<aspectratio>scale</aspectratio>
					<texture background="true" colordiffuse="C0FFFFFF">$INFO[Skin.String(centerstage.background)]</texture>
				</control>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<fadetime>400</fadetime>
				<animation effect="fade" time="400">VisibleChange</animation>
				<texture background="true" colordiffuse="37FFFFFF">$INFO[Container(100).ListItem.Art(fanart)]</texture>
				<visible>!Skin.HasSetting(no_fanart)</visible>
			</control>
		</control>

		<!-- Estuary's top bar, as in the recordings window: "Center Stage" as the breadcrumbs and
		     the Stage shown under it (the group property: "All Stages" or the group's name),
		     plus the clock and what's playing. Drawn before the panels, so its shading stays
		     behind them. The group stops 10px short of the right edge, so the clock (20px in
		     from the group's edge in TopBar) ends where the right-hand panels do. -->
		<control type="group">
			<left>0</left>
			<right>10</right>
			<include content="TopBar">
				<param name="breadcrumbs_label" value="$ADDON[script.centerstage 32001]" />
				<param name="sublabel" value="$INFO[Window.Property(group)]" />
			</include>
		</control>

		<!-- left: titles. A plain list, so the first title sits at the top. Its panel is 30px in
		     from the left and bottom of the screen and 30px from the right-hand panels, and
		     starts below the top bar, level with them. (The panel image's 20px border is
		     shadow, so 10..600 x 94..1070 shows 30..580 x 114..1050.) The list is exactly 12
		     rows of 78, so no part-row shows at the bottom. -->
		<control type="group">
			<include>OpenClose_Left</include>
			<!-- Estuary's ContentPanel, but with the opacity from the panel_opacity setting (80%
			     by default, where Estuary uses 93%), like the right-hand panels. window.py puts
			     the colour on Home (kodiutil.set_panel_colours). -->
			<control type="image">
				<left>10</left>
				<top>94</top>
				<width>590</width>
				<height>976</height>
				<texture colordiffuse="$INFO[Window(Home).Property(script.centerstage.panel)]">lists/panel.png</texture>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
			</control>
			<!-- the list (and its focus bar) runs up to the scrollbar -->
			<control type="fixedlist" id="100">
				<left>30</left>
				<top>114</top>
				<width>538</width>
				<height>936</height>
				<onright>200</onright>
				<onup>100</onup>
				<ondown>100</ondown>
				<pagecontrol>101</pagecontrol>
				<focusposition>5</focusposition>
				<movement>6</movement>
				<scrolltime tween="cubic" easing="out">300</scrolltime>
				<orientation>vertical</orientation>
				<focusedlayout height="78">
					<!-- stays, dimmed, while the episodes have focus, to mark whose they are -->
					<control type="image">
						<left>0</left>
						<right>0</right>
						<top>0</top>
						<bottom>0</bottom>
						<texture colordiffuse="button_focus">lists/focus.png</texture>
						<animation effect="fade" start="100" end="50" time="40" condition="!Control.HasFocus(100)">Conditional</animation>
					</control>
					<control type="label">
						<left>30</left>
						<right>20</right>
						<top>0</top>
						<bottom>0</bottom>
						<aligny>center</aligny>
						<scroll>true</scroll>
						<font>font36_title</font>
						<label>$INFO[ListItem.Label]</label>
						<shadowcolor>text_shadow</shadowcolor>
					</control>
				</focusedlayout>
				<itemlayout height="78">
					<control type="label">
						<left>30</left>
						<right>20</right>
						<top>0</top>
						<bottom>0</bottom>
						<aligny>center</aligny>
						<font>font14</font>
						<label>$INFO[ListItem.Label]</label>
						<shadowcolor>text_shadow</shadowcolor>
					</control>
				</itemlayout>
			</control>
			<control type="scrollbar" id="101">
				<left>568</left>
				<top>114</top>
				<width>12</width>
				<height>936</height>
				<onleft>100</onleft>
				<onright>200</onright>
				<orientation>vertical</orientation>
				<!-- unfocused it narrows towards the panel's edge, so it stays flush with it -->
				<animation effect="zoom" end="50,100" time="300" tween="sine" center="580,0" easing="inout" condition="!Control.HasFocus(101)">conditional</animation>
			</control>
			<control type="textbox">
				<left>60</left>
				<top>144</top>
				<width>470</width>
				<height>500</height>
				<font>font13</font>
				<textcolor>grey</textcolor>
				<label>$ADDON[script.centerstage 32029]</label>
				<visible>String.IsEqual(Window.Property(empty),true)</visible>
			</control>
			<!-- while the PVR starts (window.py waits for its recordings): our busy spinner
			     (resources/spinner.png, from a Home property like the empty stage), turning
			     clockwise, in the skin's focus colour -->
			<control type="group">
				<visible>String.IsEqual(Window.Property(starting),true)</visible>
				<control type="image">
					<left>255</left>
					<top>194</top>
					<width>100</width>
					<height>100</height>
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="button_focus">$INFO[Window(Home).Property(script.centerstage.spinner)]</texture>
					<animation effect="rotate" center="auto" start="0" end="360" time="1000" loop="true" condition="true">Conditional</animation>
				</control>
				<control type="label">
					<left>60</left>
					<top>314</top>
					<width>490</width>
					<height>60</height>
					<align>center</align>
					<font>font13</font>
					<textcolor>grey</textcolor>
					<label>$ADDON[script.centerstage 32115]</label>
				</control>
			</control>
		</control>

		<!-- right: episodes (or folders) on top, details below. The panels stop 30px short of the
		     right edge of the screen, the same gap as between the two sides (the panel images'
		     20px borders are shadow, so -20 puts the visible edge on the group's). Everything
		     here is placed from the right edge (<right>), never with a width that assumes 1920:
		     Kodi picks the Estuary coordinate space closest to the window's aspect (e.g. 2040 or
		     2160 wide). -->
		<!-- 202 and 203: Python adds their positions to 200's to find where it is on screen -->
		<control type="group" id="202">
			<include>OpenClose_Right</include>
			<left>610</left>
			<right>30</right>
			<control type="group" id="203">
				<top>114</top>
				<right>0</right>
				<control type="image">
					<left>-20</left>
					<top>-20</top>
					<right>-20</right>
					<height>520</height>
					<texture colordiffuse="$INFO[Window(Home).Property(script.centerstage.panel)]">lists/panel.png</texture>
					<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
				</control>
				<control type="list" id="200">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<height>480</height>
					<onleft>100</onleft>
					<onup>200</onup>
					<ondown>200</ondown>
					<pagecontrol>201</pagecontrol>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<orientation>vertical</orientation>
					<focusedlayout height="60">
						<!-- to the panel's edge: the scrollbar, when there is one, is drawn over it -->
						<control type="image">
							<left>0</left>
							<right>0</right>
							<top>0</top>
							<bottom>0</bottom>
							<texture colordiffuse="button_focus">lists/focus.png</texture>
							<visible>Control.HasFocus(200)</visible>
						</control>
						<!-- the selected row looks like the others while the list isn't focused -->
						<control type="image">
							<left>16</left>
							<centertop>50%</centertop>
							<width>32</width>
							<height>32</height>
							<texture>$VAR[ListWatchedIconVar]</texture>
							<visible>!String.IsEqual(ListItem.Property(parent),true) + Control.HasFocus(200)</visible>
						</control>
						<control type="image">
							<left>16</left>
							<centertop>50%</centertop>
							<width>32</width>
							<height>32</height>
							<texture colordiffuse="button_focus">$VAR[ListWatchedIconVar]</texture>
							<visible>!String.IsEqual(ListItem.Property(parent),true) + !Control.HasFocus(200)</visible>
						</control>
						<control type="label">
							<left>64</left>
							<right>312</right>
							<top>0</top>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<scroll>true</scroll>
							<font>font13</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
						<control type="label">
							<width>280</width>
							<right>32</right>
							<top>0</top>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<font>font12</font>
							<label>$INFO[ListItem.Label2]</label>
							<shadowcolor>text_shadow</shadowcolor>
							<visible>Control.HasFocus(200)</visible>
						</control>
						<control type="label">
							<width>280</width>
							<right>32</right>
							<top>0</top>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>grey</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<shadowcolor>text_shadow</shadowcolor>
							<visible>!Control.HasFocus(200)</visible>
						</control>
					</focusedlayout>
					<itemlayout height="60">
						<control type="image">
							<left>16</left>
							<centertop>50%</centertop>
							<width>32</width>
							<height>32</height>
							<texture colordiffuse="button_focus">$VAR[ListWatchedIconVar]</texture>
							<visible>!String.IsEqual(ListItem.Property(parent),true)</visible>
						</control>
						<control type="label">
							<left>64</left>
							<right>312</right>
							<top>0</top>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<font>font13</font>
							<label>$INFO[ListItem.Label]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
						<control type="label">
							<width>280</width>
							<right>32</right>
							<top>0</top>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>grey</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<shadowcolor>text_shadow</shadowcolor>
						</control>
					</itemlayout>
				</control>
				<!-- flush with the right edge of its panel. Unfocused it narrows towards that edge,
				     whose x is only known inside a group of its own (the panel's width varies) -->
				<control type="group">
					<right>0</right>
					<top>0</top>
					<width>12</width>
					<height>480</height>
					<control type="scrollbar" id="201">
						<left>0</left>
						<top>0</top>
						<width>12</width>
						<height>480</height>
						<onleft>200</onleft>
						<onright>200</onright>
						<orientation>vertical</orientation>
						<animation effect="zoom" end="50,100" time="300" tween="sine" center="12,0" easing="inout" condition="!Control.HasFocus(201)">conditional</animation>
					</control>
				</control>
				<control type="label">
					<left>64</left>
					<top>90</top>
					<right>64</right>
					<height>60</height>
					<font>font13</font>
					<textcolor>grey</textcolor>
					<label>$ADDON[script.centerstage 32028]</label>
					<visible>String.IsEqual(Window.Property(loading),true)</visible>
					<animation effect="fade" start="0" end="100" time="0" delay="250">Visible</animation>
				</control>
				<control type="textbox">
					<left>64</left>
					<top>90</top>
					<right>64</right>
					<height>300</height>
					<font>font13</font>
					<textcolor>grey</textcolor>
					<label>$INFO[Window.Property(message)]</label>
					<visible>!String.IsEmpty(Window.Property(message))</visible>
				</control>
			</control>

			<control type="group">
				<top>624</top>
				<right>0</right>
				<!-- 426 tall: the image is 40px taller than what shows (20px shadow each side) -->
				<control type="image">
					<left>-20</left>
					<top>-20</top>
					<right>-20</right>
					<height>466</height>
					<texture colordiffuse="$INFO[Window(Home).Property(script.centerstage.panel)]">lists/panel.png</texture>
					<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
				</control>
				<!-- Laid out like the recordings window (MyPVRRecordings.xml): the title's name, and
				     under it the episode's (with S1 E02) or the title's number of recordings;
				     opposite them, right-aligned in grey, the episode's channel/date/length or
				     where the title comes from; below, the picture on the left (16:9 fills it, 4:3
				     fills its height) and the plot beside it.
				     Everything stays in place whichever list has focus, so nothing jumps while
				     navigating; only the contents change. -->
				<control type="label">
					<left>20</left>
					<top>8</top>
					<right>440</right>
					<height>45</height>
					<font>font32_title</font>
					<scroll>true</scroll>
					<textcolor>button_focus</textcolor>
					<label>$INFO[Container(100).ListItem.Label]</label>
					<shadowcolor>text_shadow</shadowcolor>
				</control>
				<control type="label">
					<left>20</left>
					<top>53</top>
					<right>440</right>
					<height>45</height>
					<font>font36_title</font>
					<scroll>true</scroll>
					<label>$INFO[Container(200).ListItem.Property(name)]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>53</top>
					<right>440</right>
					<height>45</height>
					<font>font25_narrow</font>
					<aligny>center</aligny>
					<textcolor>grey</textcolor>
					<label>$INFO[Container(100).ListItem.Property(count)]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<right>20</right>
					<top>12</top>
					<width>400</width>
					<height>102</height>
					<font>font25_narrow</font>
					<align>right</align>
					<textcolor>grey</textcolor>
					<label>$INFO[Container(200).ListItem.Property(details)]</label>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<right>20</right>
					<top>12</top>
					<width>400</width>
					<height>102</height>
					<font>font25_narrow</font>
					<align>right</align>
					<textcolor>grey</textcolor>
					<label>$INFO[Container(100).ListItem.Property(origin)]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>110</top>
					<width>526</width>
					<height>296</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true" fallback="$INFO[Window(Home).Property(script.centerstage.stage)]">$INFO[Container(100).ListItem.Art(thumb)]</texture>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>110</top>
					<width>526</width>
					<height>296</height>
					<aspectratio>keep</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true" fallback="$INFO[Container(200).ListItem.Property(fallback)]">$INFO[Container(200).ListItem.Art(thumb)]</texture>
					<visible>Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<left>566</left>
					<top>110</top>
					<right>20</right>
					<height>296</height>
					<font>font14</font>
					<label>$INFO[Container(100).ListItem.Plot]</label>
					<autoscroll delay="10000" time="3000" repeat="10000">Skin.HasSetting(autoscroll)</autoscroll>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="textbox">
					<left>566</left>
					<top>110</top>
					<right>20</right>
					<height>296</height>
					<font>font14</font>
					<label>$INFO[Container(200).ListItem.Plot]</label>
					<autoscroll delay="10000" time="3000" repeat="10000">Skin.HasSetting(autoscroll)</autoscroll>
					<visible>Control.HasFocus(200)</visible>
				</control>
			</control>
		</control>

		<!-- PVR backend disk space used, centred in the top bar, as text only (the user didn't
		     want a bar). Hidden while something plays, when the top bar shows what's playing
		     there, and when the backend doesn't report it (PVR.BackendDiskSpaceProgr is then
		     255). The text, e.g. "62% backend disk space used", is the diskspace property: that
		     number has no label form, so window.py works it out (kodiutil.disk_used_percent). -->
		<control type="group">
			<depth>DepthBars</depth>
			<centerleft>50%</centerleft>
			<top>12</top>
			<width>500</width>
			<include>OpenClose_Right</include>
			<visible>String.IsEqual(Window.Property(pvr),true) + !Integer.IsGreater(PVR.BackendDiskSpaceProgr,100) + !Player.HasMedia</visible>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>500</width>
				<height>30</height>
				<align>center</align>
				<font>font25_narrow</font>
				<label>$INFO[Window.Property(diskspace)]</label>
				<shadowcolor>text_shadow</shadowcolor>
			</control>
		</control>
	</controls>
</window>
